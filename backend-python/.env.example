ENVIRONMENT=development
APP_DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080
API_PREFIX=
CORS_ORIGINS=*

# Vertex AI (Gemini)
# Auth: gcloud auth application-default login
# or set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
VERTEX_PROJECT_ID=hack-team-alphainnovators
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-pro
VERTEX_TEMPERATURE=0.2
VERTEX_MAX_OUTPUT_TOKENS=8192

# Retry
RETRY_ATTEMPTS=3
RETRY_MIN_WAIT_SECONDS=1
RETRY_MAX_WAIT_SECONDS=8

# Paths / limits
UPLOAD_DIR=uploads
GENERATED_DIR=generated
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=py,zip
MAX_FILES_PER_JOB=200
MAX_SOURCE_CHARS_PER_FILE=40000
MAX_TOTAL_SOURCE_CHARS=200000
TESTS_SUBDIR=tests

# PRD → Jira (additive feature)
PRD_UPLOAD_DIR=uploads/prd
PRD_GENERATED_DIR=generated/prd
PRD_ALLOWED_EXTENSIONS=pdf,docx,txt,md
MAX_PRD_CHARS=150000

# AI Documentation (Feature 3)
DOCS_UPLOAD_DIR=uploads/docs
DOCS_GENERATED_DIR=generated/docs
DOCS_ALLOWED_EXTENSIONS=py,zip
